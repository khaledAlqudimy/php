APP_NAME="قطعة وقصة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456_qet3a
DB_USERNAME=u123456_qet3a_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# البريد — مطلوب لاستلام رسائل «تواصل معنا»
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# الدفع الإلكتروني Moyasar — اتركه فارغاً لإخفاء خيار الدفع الإلكتروني
# مفتاح التجربة يبدأ بـ sk_test_ ومفتاح الإنتاج بـ sk_live_ (من لوحة Moyasar ← Settings ← API Keys)
MOYASAR_SECRET_KEY=
# مدة حجز القطع لطلب إلكتروني لم يُدفع (بالدقائق) قبل إلغائه تلقائياً
MOYASAR_UNPAID_TTL=60

# حساب المدير الأول — كلمة المرور إلزامية (لا توجد قيمة افتراضية)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=
